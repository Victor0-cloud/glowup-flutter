<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camera — Food Scan, Skin & Acne Scan, and Glow Shop Scanner's live
         barcode recognition. android:required="false" so the app still
         installs on camera-less devices (e.g. some tablets); every screen
         that uses the camera already falls back honestly to a gallery/
         manual-entry path when it isn't available (see
         ImageAcquisitionProvider.supportsCameraCapture /
         supportsLiveBarcodeScan). No other hardware/permission requested
         here. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Walking & Steps — phone-only step counting (Android's
         TYPE_STEP_COUNTER sensor via the `pedometer` plugin), required at
         runtime on Android 10+ (API 29+). android:required="false" so the
         app still installs on devices with no step-counter hardware;
         WalkingHomeScreen shows an honest "not available" state there
         (see StepSource.isSupported/checkCapability) rather than hiding
         the module. Fine location is requested only when the user
         actually taps "Start Walk" (never eagerly) for real GPS
         distance/pace during a walk session — see
         WalkSessionController._startLocation. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- AI Coach voice input (speech-to-text via the `speech_to_text`
         plugin) — requested only when the user taps the mic button in
         Chat (CoachVoiceInputController.startListening), never eagerly.
         Denial is handled honestly (CoachListenStatus.permissionDenied),
         never a crash. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="glow_up"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase Google/email auth callback — approved redirect
                 glowup://auth-callback. Handled automatically by
                 supabase_flutter's internal app_links listener once
                 Supabase.initialize() has run; no extra Dart wiring here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="glowup" android:host="auth-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
