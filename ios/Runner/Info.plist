<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Glow Up</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>glow_up</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Supabase Google/email auth callback — approved redirect
	     glowup://auth-callback. Handled automatically by
	     supabase_flutter's internal app_links listener once
	     Supabase.initialize() has run; no extra Dart wiring here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glowup</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.glowup.glowUp.auth</string>
		</dict>
	</array>
	<!-- Camera — Food Scan, Skin & Acne Scan, and Glow Shop Scanner's live
	     barcode recognition. REQUIRED: iOS terminates the app on any
	     camera access attempt without this key present, regardless of
	     whether the feature is actually reached. No other privacy-
	     sensitive permission is requested. -->
	<key>NSCameraUsageDescription</key>
	<string>Glow Up uses your camera so you can photograph a meal, take a Skin Scan photo, or scan a product barcode — always started by your own tap, never automatically.</string>
	<!-- Walking & Steps — phone-only step counting via Core Motion
	     (CMPedometer, wrapped by the `pedometer` plugin). REQUIRED for any
	     motion/fitness data access, regardless of whether the feature is
	     actually reached. -->
	<key>NSMotionUsageDescription</key>
	<string>Glow Up uses motion &amp; fitness data to count your steps for Walking &amp; Steps — no Apple Watch or Fitbit required.</string>
	<!-- Real GPS distance/pace during a "Start Walk" session only — never
	     requested until the user actually starts a walk (see
	     WalkSessionController._startLocation), and only "when in use," never
	     background/always. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Glow Up uses your location only while you're on a Start Walk session, to track real distance and pace.</string>
	<!-- AI Coach voice input (speech-to-text via the `speech_to_text`
	     plugin) — requested only when the user taps the mic button in Chat
	     (CoachVoiceInputController.startListening), never eagerly. Both
	     keys are required by iOS for on-device speech recognition. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Glow Up uses your microphone so you can speak your message to the AI Coach instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Glow Up uses speech recognition to turn what you say to the AI Coach into text.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
